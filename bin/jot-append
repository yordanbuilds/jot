#!/usr/bin/env bash
# jot-append — append one captured thought to the configured inbox file.
# Usage: jot-append <text>. Multi-line text lands as one markdown todo:
# the first line goes through the template, continuation lines are
# indented two spaces (markdown list continuation).
set -u

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
text="${1:-}"
[[ -n ${text//[[:space:]]/} ]] || exit 0

# A newline at either edge is a stray Shift+Enter, not content. Left in, a
# trailing one writes a permanent blank continuation line ("  ") and a leading
# one templates an empty first line with the real thought indented beneath it.
while [[ $text == *$'\n' ]]; do text=${text%$'\n'}; done
while [[ $text == $'\n'* ]]; do text=${text#$'\n'}; done

fail() {
  # The body goes out with a leading space on purpose: the real
  # omarchy-notification-send only takes it positionally when it doesn't look
  # like an option (`[[ $1 != -* ]]`), so a capture starting with "-" would be
  # swallowed into option passthrough and the toast lost — the one trace a
  # failed capture leaves. The space defeats that check and is invisible in
  # the toast.
  command -v omarchy-notification-send >/dev/null 2>&1 &&
    omarchy-notification-send "Jot couldn't save" " $text" || true
  exit 1
}

file="" template=""
{ IFS= read -r file; IFS= read -r template; } < <("$HERE/jot-config")
[[ -n $file && -n $template ]] || fail

# The template goes through date first; {text} is substituted afterward and
# quoted on both sides of the expansion — so % in the captured text is never
# eaten by date, and no sed/glob/patsub metacharacters are ever interpreted.
rendered="$(date +"$template")" || fail
first="${text%%$'\n'*}"
if [[ $rendered == *"{text}"* ]]; then
  entry="${rendered//"{text}"/"$first"}"
else
  entry="$rendered $first"
fi
if [[ $text == *$'\n'* ]]; then
  rest="${text#*$'\n'}"
  while IFS= read -r l; do entry+=$'\n'"  $l"; done <<<"$rest"
fi

mkdir -p "$(dirname "$file")" 2>/dev/null || fail
printf '%s\n' "$entry" 2>/dev/null >>"$file" || fail
