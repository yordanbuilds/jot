#!/usr/bin/env bash
# jot-setup — one-time omakase setup, run by the plugin on first load.
# Writes the default config and the Omarchy menu rows. It takes no keybinding:
# the first load asks about SUPER+N through jot-ask-key, and only that answer —
# or the menu row that waits behind it — ever writes one. Idempotent via
# ~/.config/jot/.setup-done; --force re-runs it. Everything it writes sits in
# marked blocks and is yours to edit — jot-setup never rewrites an existing one.
set -euo pipefail

SCRIPT="$(readlink -f "${BASH_SOURCE[0]}")"
PLUGIN_DIR="$(dirname "$(dirname "$SCRIPT")")"
FLAG="$HOME/.config/jot/.setup-done"
MENU="$HOME/.config/omarchy/extensions/omarchy-menu.jsonc"
first_run=true
[[ -e $FLAG ]] && first_run=false
[[ $first_run == false && ${1:-} != --force ]] && exit 0

notify() { command -v omarchy-notification-send >/dev/null 2>&1 && omarchy-notification-send "$1" "$2" || true; }

mkdir -p "$HOME/.config/jot"

# --- Default config, only if absent ------------------------------------------
if [[ ! -e "$HOME/.config/jot/config.json" ]]; then
  cat >"$HOME/.config/jot/config.json" <<'EOF'
{
  "file": "~/notes/inbox.md",
  "template": "- [ ] %Y-%m-%d %H:%M {text}"
}
EOF
fi

# --- Menu rows, only if absent -----------------------------------------------
# The last row offers the key Jot never takes by itself, and its `when:` hides
# it once a shortcut exists. Cheap on purpose: the menu batches every guard
# into one bash script, and that script's speed is how fast the menu opens.
if ! grep -q '>>> jot menu >>>' "$MENU" 2>/dev/null; then
  mkdir -p "$(dirname "$MENU")"
  [[ -s $MENU ]] || printf '{\n}\n' >"$MENU"
  blocktmp="$(mktemp)"; tmp="$(mktemp)"
  trap 'rm -f "$blocktmp" "$tmp"' EXIT
  cat >"$blocktmp" <<EOF
  // >>> jot menu >>>  Added once by Jot setup — yours to edit or remove.
  "trigger.jot": { "icon": "󰎞", "label": "Jot", "aliases": ["jot"] },
  "trigger.jot.down": { "icon": "󰙏", "label": "Jot down", "action": "omarchy-shell shell toggle yordanbuilds.jot '{}'" },
  "trigger.jot.inbox": { "icon": "󰮒", "label": "Open inbox", "action": "$PLUGIN_DIR/bin/jot-open-inbox" },
  "trigger.jot.bind-key": { "icon": "󰌌", "label": "Add SUPER+N shortcut", "action": "$PLUGIN_DIR/bin/jot-bind-key", "when": "! grep -q '>>> jot >>>' ~/.config/hypr/bindings.lua" },
  // <<< jot menu <<<
EOF
  # Insert before the file's closing brace, adding a comma to the preceding
  # entry if it lacks one (same approach as Rig's rig-menu-sync). A file with
  # no closing brace on a line of its own is one we don't understand: say so
  # and carry on, rather than dying here and leaving setup half-done forever.
  if awk -v blockfile="$blocktmp" '
    { lines[NR] = $0 }
    END {
      last = 0
      for (i = 1; i <= NR; i++) if (lines[i] ~ /^[[:space:]]*}[[:space:]]*$/) last = i
      if (last == 0) exit 3
      for (j = last - 1; j >= 1; j--) {
        t = lines[j]
        sub(/[[:space:]]+$/, "", t)
        if (t == "" || t ~ /^[[:space:]]*\/\//) continue
        if (t !~ /[,{[]$/) lines[j] = lines[j] ","
        break
      }
      for (i = 1; i <= NR; i++) {
        if (i == last) while ((getline line < blockfile) > 0) print line
        print lines[i]
      }
    }
  ' "$MENU" >"$tmp"; then
    mv "$tmp" "$MENU"
  else
    notify "Jot" "Couldn't add menu entries — add them by hand (see README)"
  fi
fi

touch "$FLAG"

# The key question comes to you, once, seconds after the install: jot-ask-key
# opens a floating terminal and asks. Nonzero means it stayed quiet — the key is
# taken, a binding already exists, or there's no launcher to ask through — and
# then the notification is what points at the menu row instead.
asked=false
if [[ $first_run == true ]] && "$PLUGIN_DIR/bin/jot-ask-key"; then asked=true; fi

if [[ $asked == true ]]; then
  notify "Jot is ready" "Jot down and Open inbox are in the Omarchy menu, and config.json is in ~/.config/jot."
else
  notify "Jot is ready" "Jot down and Open inbox are in the Omarchy menu, and config.json is in ~/.config/jot. No key was taken — add the SUPER+N shortcut from the menu when you want it."
fi
