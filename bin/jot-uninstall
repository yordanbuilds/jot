#!/usr/bin/env bash
# jot-uninstall — remove everything Jot added, the shortcut included. Run by
# full path:
#   ~/.config/omarchy/plugins/yordanbuilds.jot/bin/jot-uninstall [--purge]
# Never touches your notes file. Finish with:
#   omarchy plugin remove yordanbuilds.jot
set -u

BINDINGS="$HOME/.config/hypr/bindings.lua"
MENU="$HOME/.config/omarchy/extensions/omarchy-menu.jsonc"

[[ -f $BINDINGS ]] && sed -i '/>>> jot >>>/,/<<< jot <<</d' "$BINDINGS"
[[ -f $MENU ]] && sed -i '/>>> jot menu >>>/,/<<< jot menu <<</d' "$MENU"

# The setup flag is our bookkeeping, not your data, so it goes unconditionally:
# leaving it behind would make a later reinstall no-op into a dead plugin —
# jot-setup would see the flag and skip the binding and menu rows entirely.
rm -f "$HOME/.config/jot/.setup-done"

purge="${1:-}"
if [[ $purge != --purge && -t 0 && -d "$HOME/.config/jot" ]]; then
  read -rp "Remove ~/.config/jot (your config)? [y/N] " ans
  [[ ${ans,,} == y* ]] && purge=--purge
fi
[[ $purge == --purge ]] && rm -rf "$HOME/.config/jot"

echo "Jot's menu entries are removed, and the keybinding with them if you added one."
echo "Finish with: omarchy plugin remove yordanbuilds.jot"
